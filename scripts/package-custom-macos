#!/bin/bash
# Ad-hoc signed preview, independent of official release credentials.
set -euo pipefail
[[ $(uname -s) == Darwin && $(uname -m) == arm64 ]] || {
  echo 'Requires an Apple Silicon Mac.' >&2; exit 1;
}
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
version=$(sed -n 's/^version = "\([^"]*\)"/\1/p' Cargo.toml | head -1)
build=${CUSTOM_BUILD_NUMBER:-1}
[[ $build =~ ^[0-9]+$ ]] || { echo 'Build number must be numeric.' >&2; exit 1; }
profile=${CUSTOM_BUILD_PROFILE:-release}
custom_version="$version.$build"
if [[ $# == 0 ]]; then
  env -u HERDR_APP_RELEASE HERDR_CUSTOM_VERSION="$custom_version" cargo build --locked --release
  binary="${CARGO_TARGET_DIR:-$root/target}/release/herdr-app"
else
  binary=$1
fi
[[ -f $binary ]] || { echo "Missing binary: $binary" >&2; exit 1; }
file "$binary" | grep -q 'Mach-O 64-bit executable arm64' || {
  echo 'Expected an arm64 executable.' >&2; exit 1;
}
[[ $("$binary" --version) == "herdr-app $custom_version" ]] || {
  echo "Binary must be built with HERDR_CUSTOM_VERSION=$custom_version." >&2; exit 1;
}
work=$(mktemp -d "${TMPDIR:-/tmp}/herdr-custom-package.XXXXXX")
trap 'rm -rf "$work"' EXIT
app="$work/source/Herdr Custom.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" "$root/dist"
cp "$binary" "$app/Contents/MacOS/HerdrCustom"
strip -S "$app/Contents/MacOS/HerdrCustom"
cp assets/icons/Herdr.icns LICENSE THIRD-PARTY-NOTICES "$app/Contents/Resources/"
cat > "$app/Contents/MacOS/LaunchHerdr" <<'LAUNCH'
#!/bin/sh
export HERDR_APP_HOME="${HERDR_APP_HOME:-$HOME/.config/herdr-custom}"
# Automation may disable color for its own logs; interactive GUI terminals
# must not inherit that setting from the process which opened the app.
unset NO_COLOR
exec "$(dirname "$0")/HerdrCustom" "$@"
LAUNCH
chmod 755 "$app/Contents/MacOS/"*
python3 - "$app" "$version" "$build" "$profile" <<'PY'
import json, pathlib, plistlib, subprocess, sys
app, version, build, profile = sys.argv[1:]
contents = pathlib.Path(app) / 'Contents'
plist = dict(
    CFBundleExecutable='LaunchHerdr', CFBundleIdentifier='dev.herdr.custom.panedrag',
    CFBundleName='Herdr Custom', CFBundleDisplayName='Herdr Custom',
    CFBundleIconFile='Herdr', CFBundlePackageType='APPL',
    CFBundleShortVersionString=f'{version}.{build}', CFBundleVersion=build,
    LSMinimumSystemVersion='11.0', NSPrincipalClass='NSApplication',
    NSHighResolutionCapable=True,
    NSMicrophoneUsageDescription='Terminal programs running in Herdr can use the microphone, for example for voice input.',
    NSCameraUsageDescription='Terminal programs running in Herdr can use the camera.',
    NSAppleEventsUsageDescription='Terminal programs running in Herdr can use AppleScript to control other apps.',
)
with (contents / 'Info.plist').open('wb') as f:
    plistlib.dump(plist, f)
metadata = dict(
    repository='https://github.com/willianzhuo/herdr-app',
    commit=subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip(),
    version=version, build=build, update_version=f'{version}.{build}',
    update_repository='willianzhuo/herdr-app', profile=profile, architecture='arm64',
    signing='ad-hoc; not notarized',
    minimum_core=pathlib.Path('distribution/core-version').read_text().strip(),
)
(contents / 'Resources' / 'custom-build.json').write_text(json.dumps(metadata, indent=2) + '\n')
PY
codesign --force --deep --sign - "$app"
codesign --verify --deep --strict "$app"
ln -s /Applications "$work/source/Applications"
cat > "$work/source/README.txt" <<'README'
Herdr Custom — Apple Silicon preview / 定制预览版

安装：将 Herdr Custom.app 拖到 Applications，然后从 Applications 打开。
Install: drag Herdr Custom.app to Applications, then open the installed app.

功能：加宽 Tab；拖动终端面板顶部中央的把手到另一 Tab，或拖到 Tab
栏右侧空白处创建新 Tab。运行中的终端进程会保留，仅支持同一工作区。
Traex：支持 Agent 名称识别和官方 Logo；状态上报已测试 Traex 0.214.1。
旧版 0.213.1 的测试未上报状态，已有旧会话不会被自动重启。
Traex recognition uses the official logo. Native agent status was verified with
Traex 0.214.1; the 0.213.1 control did not report status. Old sessions stay running.
Tab 默认宽度 220px，可在 Settings → Look → Tab width 调整为 160–400px。
Traex 的 Agents/Tab/Panel 显示实际保存的 Session 名。
会话名查询需要目标机有 Python 3 且当前进程的会话元数据可读；否则沿用终端标题。
Tabs default to 220px wide; adjust them in Settings → Look → Tab width (160–400px).
Traex session names appear in Agents, tabs and pane headers.
Name lookup needs Python 3 and readable process/session metadata on that machine;
otherwise it keeps the terminal title. Session/status processes are not modified.

Features: wider tabs; drag a pane's top-center grip onto another tab to merge,
or onto the tab-strip blank area to detach. Moves preserve the running terminal
and work within one workspace.

Files 支持 Markdown 预览与只读源码切换。打开文件后，点击 Panel 放到
终端旁，或点击 New tab 单独打开；文件 Panel 可以用顶部把手分屏移动、
拖入同一工作区的其他 Tab，或拖到 Tab 栏空白处。文件路径和机器会保留。
Files renders Markdown with a read-only Source toggle. Open a file and choose
Panel or New tab, then use its top-center grip to move it like a terminal pane.
File panes retain their path and machine across moves and app restarts.
Files 顶部支持输入目录路径，回车或点击“打开”跳转；点击“跟随终端”
恢复跟随当前终端。右键文件夹可复制相对路径或绝对路径到本机剪贴板。
相对路径以当前 Files 根目录为基准，SSH 路径属于当前远端机器。
Files accepts a folder path on the current machine (absolute, relative or ~/).
Enter or 打开 navigates; 跟随终端 resumes following terminal cwd. Right-click
a folder to copy its root-relative or absolute filesystem path locally.
右键文件或文件夹选择“下载…”：默认保存到本机 Downloads，可选择其他
目录，查看进度并打开保存位置。文件保留二进制内容，文件夹保存为 .tar.gz。
重名自动编号不覆盖；关闭进度窗口后，已启动的下载继续运行。
本机和源机器需要 Python 3；保存目录须支持硬链接（例如本机 Downloads）。
Right-click files or folders and choose 下载… to download locally with progress.
Files retain binary bytes; folders become .tar.gz archives. Existing files are
never overwritten. A started transfer continues after its progress window closes.
Python 3 is needed on both machines; choose a local destination supporting hard links.

机器名旁显示毫秒响应时间；点击延时或 Spaces 的齿轮可关闭测量，
也可设置高延时和超时门槛。这是本机经 Core 到远端执行的响应时间。
Machine badges show round-trip command response time in milliseconds, not ICMP
ping. Use a badge or the Spaces gear to toggle probes and set thresholds.

Ports 支持 SSH 开发端口自动发现、手动转发、端口冲突分配和重连。
停止转发不会停止远端服务。后台训练监控可通过随包提供的
mods/ports/herdr-monitor.py 登记服务并向 Agent 返回实际本机 URL；
部署方法见 App 配置目录中的 mods/ports/README.md。
Ports supports SSH listener discovery, manual forwarding, local port conflict
allocation and reconnects. Stopping a mapping leaves the remote service running.
The packaged monitor helper lets agents register detached services and retrieve
actual local URLs; see mods/ports/README.md in the app configuration directory.
Claude Code 后台 Session 和 Agent Dashboard 支持独立状态显示。
Claude Code background sessions and its Agent Dashboard show their own status.

仅支持 Apple Silicon。herdr-core 需要单独安装（最低 0.1.11，已测试
0.1.18 / 0.1.19），首次打开可按提示安装。
Apple Silicon only. Install herdr-core separately (minimum 0.1.11; tested with
0.1.18 / 0.1.19). The first-run screen offers installation.
macOS 可能要求为 Herdr Custom 授予“App 管理”权限，才允许它更新
独立的 Herdr Core.app；普通文件夹写权限不能替代此系统授权。
macOS may require App Management permission before Custom can update the
separate Herdr Core.app. Ordinary folder write access does not grant it.

这是第三方 fork 的预览包，使用 ad-hoc 签名，尚未经过 Apple 公证。
macOS 可能阻止首次打开。仅在确认来源可信后，在系统设置 → 隐私与安全性
查看系统提供的“仍要打开”选项；组织管理的电脑可能限制运行。
This third-party preview is ad-hoc signed, not Apple notarized. macOS may block
it. For a trusted download, review the system's Open Anyway option in System
Settings > Privacy & Security. Managed computers may prohibit running it.

独立配置目录：~/.config/herdr-custom（使用接收者自己的用户目录）。
安装包不包含作者的 SSH 配置、机器列表、会话或密钥。原版 App 可以保留。
App preferences use your own ~/.config/herdr-custom. No author's SSH settings,
machine list, sessions or keys are bundled. You can keep the official app.
已有的 herdr-core 及其机器/终端状态可能由两个 App 共享。
An existing herdr-core and its machine/terminal state may be shared by both apps.

此版本会检查本 fork 的 GitHub Releases（含 custom-v 预览版）。
启动后和每小时检查，也可在 Settings → Updates 点击 Check now。
下载并校验完成后点击 Restart to update；配置和运行中的终端保留。
App 更新不会自动重启/更新共享的 herdr-core，其更新需单独点击。
请先复制到可写的 Applications 目录；DMG 内的 App 不能就地更新。
Checks this fork's GitHub Releases at startup and hourly; Settings > Updates
also offers Check now. Verified downloads offer Restart to update. Preferences
and running terminals survive; core updates remain a separate manual action.
Install into a writable Applications folder before using in-app updates.
Source: https://github.com/willianzhuo/herdr-app
Upstream: https://github.com/herdrdev/herdr-app
License and third-party notices: inside the app's Contents/Resources.
README
name="Herdr-Custom-${version}.${build}-macos-arm64"
out="$root/dist/$name.dmg"
[[ ! -e $out ]] || { echo "Refusing to overwrite: $out" >&2; exit 1; }
hdiutil create -volname 'Herdr Custom' -srcfolder "$work/source" -format UDZO "$out"
hdiutil verify "$out"
(cd "$root/dist" && shasum -a 256 "$name.dmg" > "$name.dmg.sha256")
archive="$name-update.tar.gz"
[[ ! -e "$root/dist/$archive" ]] || { echo "Refusing to overwrite: $archive" >&2; exit 1; }
COPYFILE_DISABLE=1 tar -czf "$root/dist/$archive" -C "$work/source" 'Herdr Custom.app'
(cd "$root/dist" && shasum -a 256 "$archive" > "$archive.sha256")
echo "Packaged: $out"
echo "Updater archive: $root/dist/$archive"
